# Database
DATABASE_URL=sqlite+aiosqlite:///./data/downtime_tracker.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/downtime_tracker

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_FORUM_CHAT_ID=-1000000000000

# Topic IDs (create topics in Telegram forum, then fill IDs)
TOPIC_MAINTENANCE=0
TOPIC_PROCESS=0
TOPIC_PRODUCTION=0
TOPIC_QUALITY=0

# JWT
JWT_SECRET=change-me-to-a-secure-64-char-secret-key
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# App
APP_NAME=SMT Downtime Tracker
DEBUG=true

# Work schedule
WORK_DAY_START_HOUR=8
WORK_DAY_END_HOUR=16
WORK_DAYS=[0,1,2,3,4]

# Escalation (seconds)
ESCALATION_INTERVALS=[300,900,1800]
ESCALATION_CHECK_INTERVAL=30
