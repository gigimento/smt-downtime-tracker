DB_PASSWORD=replace-with-a-strong-postgres-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://smt_user:replace-with-a-strong-postgres-password@localhost:5432/downtime_tracker
CORS_ORIGINS=["https://smt-tracker.yourdomain.com"]

TELEGRAM_BOT_TOKEN=
TELEGRAM_FORUM_CHAT_ID=0
TOPIC_MAINTENANCE=0
TOPIC_PROCESS=0
TOPIC_PRODUCTION=0
TOPIC_QUALITY=0

ENVIRONMENT=production
DEBUG=false
AUTO_CREATE_TABLES=true
RUN_BACKGROUND_WORKERS=true

WORK_DAY_START_HOUR=8
WORK_DAY_END_HOUR=16
WORK_DAYS=[0,1,2,3,4]
ESCALATION_INTERVALS=[300,900,1800]
ESCALATION_CHECK_INTERVAL=30
